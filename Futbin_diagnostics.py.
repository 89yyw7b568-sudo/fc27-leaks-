
import requests
import re

URL = "https://www.futwiz.com/fc27/players"

print("FC 27 FUTWIZ price diagnostic")
print("Testing:", URL)

try:
    response = requests.get(
        URL,
        headers={"User-Agent": "Mozilla/5.0"},
        timeout=30,
    )

    print("HTTP status:", response.status_code)
    print("Final URL:", response.url)
    print("Page length:", len(response.text))

    if response.status_code == 200:
        print("RESULT: FUTWIZ page is reachable.")

        text = re.sub(r"<[^>]+>", " ", response.text)
        text = re.sub(r"\s+", " ", text)

        for term in ["Pele", "Maldini", "Zidane", "Console"]:
            pos = text.lower().find(term.lower())
            if pos >= 0:
                print(f"\n--- {term} sample ---")
                print(text[max(0, pos - 100):pos + 300])

        print("\nDiagnostic complete.")
    else:
        print("RESULT: Page did not return HTTP 200.")
        print(response.text[:300])

except requests.RequestException as exc:
    print("REQUEST ERROR:", str(exc))
